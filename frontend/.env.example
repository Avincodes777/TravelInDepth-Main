# Backend API URL (for local dev default: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Sentry React Error Monitoring (Create free React project at sentry.io -> Settings -> Client Keys / DSN)
# You can set either VITE_SENTRY_DSN_FRONTEND or VITE_SENTRY_DSN
VITE_SENTRY_DSN_FRONTEND=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Google OAuth 2.0 Client ID (Create via Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web Application)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
