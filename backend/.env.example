MONGO_URI=your_mongodb_connection_string
PORT=5000
# Deployed Vercel Frontend URL (e.g. https://your-project.vercel.app or http://localhost:5173 for local dev)
FRONTEND_URL=https://your-project.vercel.app
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key
# Gemini AI API Key for itinerary generation
GEMINI_API_KEY=your_gemini_api_key

# OpenTripMap API Key for real attraction data (Sign up for a free key at https://opentripmap.io/ or https://opentripmap.com/ — free tier, no credit card required)
OPENTRIPMAP_API_KEY=your_opentripmap_api_key

# Unsplash API Access Key (Get a free key from https://unsplash.com/developers — free tier, no credit card required)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Cloudinary Credentials for Media Storage (Dashboard -> Programmable Media -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Sentry Error Monitoring (Create free Node.js project at sentry.io -> Settings -> Client Keys / DSN)
# You can set either SENTRY_DSN_BACKEND or SENTRY_DSN
SENTRY_DSN_BACKEND=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Google OAuth 2.0 Client ID (Create via Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web Application)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP / Email Configuration for Password Resets & Notifications
# Option 1: Custom SMTP (Brevo / SendGrid / Amazon SES / Hostinger)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Travel In Depth" <noreply@travelindepth.com>

# Option 2: Gmail App Password (Alternative to SMTP)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_digit_app_password